{
  "manifest_version": 3,
  "name": "Meshy 3D Studio PRO",
  "version": "1.0.0",
  "description": "3D Asset Studio & Model Downloader for Meshy.ai. Intercept, inspect and download GLB models with local optimization tools.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Meshy 3D Studio PRO"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.meshy.ai/*",
    "https://*.meshy.ai/*",
    "https://assets.meshy.ai/*",
    "http://localhost:9999/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.meshy.ai/*"],
      "js": ["page_inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.meshy.ai/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
